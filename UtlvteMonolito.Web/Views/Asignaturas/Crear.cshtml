@model UtlvteMonolito.Web.Models.Asignatura
@{
    ViewData["Title"] = "Registrar Asignatura - UTLVTE";
}

<div class="container mt-4">
    <h2>Registrar Nueva Asignatura</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Crear">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Codigo" class="control-label">Código</label>
                    <input asp-for="Codigo" class="form-control" />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Nombre" class="control-label">Nombre de la Asignatura</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Creditos" class="control-label">Créditos</label>
                    <input asp-for="Creditos" class="form-control" type="number" />
                    <span asp-validation-for="Creditos" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Nivel" class="control-label">Nivel / Ciclo</label>
                    <input asp-for="Nivel" class="form-control" />
                    <span asp-validation-for="Nivel" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <button type="submit" class="btn btn-success">Guardar Asignatura</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
                </div>
            </form>
        </div>
    </div>
</div>