@model IEnumerable<UtlvteMonolito.Web.Models.Asignatura>
@{
    ViewData["Title"] = "Gestión de Asignaturas - UTLVTE";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Asignaturas</h2>
        <a asp-action="Crear" class="btn btn-primary">+ Registrar Nueva Asignatura</a>
    </div>
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Nivel</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.Creditos</td>
                    <td>@item.Nivel</td>
                </tr>
            }
        </tbody>
    </table>
</div>