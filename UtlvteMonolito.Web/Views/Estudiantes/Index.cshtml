@model IEnumerable<UtlvteMonolito.Web.Models.Estudiante>

@{
    ViewData["Title"] = "Lista de Estudiantes";
}

<div class="container mt-4">
    <h2 class="mb-3">Listado de Estudiantes - UTLVTE</h2>
    
    <p>
        <a asp-action="Crear" class="btn btn-primary">Registrar Nuevo Estudiante</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Cédula</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Correo Institucional</th>
                <th>Carrera</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Cedula</td>
                <td>@item.Nombres</td>
                <td>@item.Apellidos</td>
                <td>@item.CorreoInstitucional</td>
                <td>@item.Carrera</td>
                <td>@(item.EstadoActivo ? "Activo" : "Inactivo")</td>
            </tr>
        }
        </tbody>
    </table>
</div>